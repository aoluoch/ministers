# Paste your Google Form URL here (no quotes).
# Example: VITE_REGISTER_FORM_URL=https://docs.google.com/forms/d/e/XXXX/viewform
VITE_REGISTER_FORM_URL=

# Contentful Content Delivery API (optional — falls back to src/content/* when unset)
# Copy these into .env (Vite does not load .env.example)
# Space Settings → API keys → Content delivery / preview tokens
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ACCESS_TOKEN=
# Optional; defaults to "master"
VITE_CONTENTFUL_ENVIRONMENT=master
