# Canonical production origin (no trailing slash).
# Used for canonical URLs, Open Graph/Twitter URLs, sitemap.xml and robots.txt.
# Defaults to https://youngministers.org when unset.
VITE_SITE_URL=https://youngministers.org

# Contentful Content Delivery API
# Copy these into .env (Vite does not load .env.example)
# Space Settings → API keys → Content delivery / preview tokens
VITE_CONTENTFUL_SPACE_ID=
VITE_CONTENTFUL_ACCESS_TOKEN=
# Optional; defaults to "master"
VITE_CONTENTFUL_ENVIRONMENT=master
